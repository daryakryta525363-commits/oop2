<Window x:Class="DotaHeroes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota 2 Heroes Management System"
        Height="560" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="Dota 2 Heroes" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="Методы" Width="100" Height="30" Margin="6,0,0,0"
                    DockPanel.Dock="Right" Click="Methods_Click"/>
            <Button Content="Обновить" Width="100" Height="30" Margin="6,0,0,0"
                    DockPanel.Dock="Right" Click="RefreshHeroes_Click"/>
            <Button Content="Удалить" Width="100" Height="30" Margin="6,0,0,0"
                    DockPanel.Dock="Right" Click="DeleteHero_Click"/>
            <Button Content="Редактировать" Width="110" Height="30" Margin="6,0,0,0"
                    DockPanel.Dock="Right" Click="EditHero_Click"/>
            <Button Content="Добавить" Width="100" Height="30" Margin="6,0,0,0"
                    DockPanel.Dock="Right" Click="AddHero_Click"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchTextBox" Width="220" Height="26"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>
            <Button Content="Очистить" Width="90" Height="26" Margin="8,0,0,0"
                    Click="ClearSearch_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="HeroesGrid"
                  ItemsSource="{Binding FilteredHeroes}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="HP" Binding="{Binding Health}" Width="70"/>
                <DataGridTextColumn Header="Урон" Binding="{Binding Damage}" Width="70"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="100"/>
                <DataGridTextColumn Header="Специфика" Binding="{Binding SpecificInfo}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="Подключение к базе данных..."/>
        </StatusBar>
    </Grid>
</Window>
